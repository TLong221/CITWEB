@page
@model DangkyModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["HideNav"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dangky.css" asp-append-version="true" />
}

<div class="signup-page">
    <main class="signup-shell">
        <section class="signup-visual" aria-hidden="true">
            <div class="visual-overlay"></div>
            <div class="visual-card">
                <div class="hero-mark"><i data-lucide="leaf"></i></div>
                <h1>Serene</h1>
                <p>"Nơi tìm thấy bình yên trong từng nhịp thở và suy nghĩ của bạn."</p>
                <div class="tag-row">
                    <span>Chánh niệm</span>
                    <span>Tĩnh lặng</span>
                    <span>Cảm xúc</span>
                </div>
            </div>
        </section>

        <section class="signup-panel">
            <div class="panel-header">
                <span class="sign-icon"><i data-lucide="sparkles"></i></span>
                <h2>Serene</h2>
                <p>Hãy tạo tài khoản để lưu giữ những khoảnh khắc bình yên của bạn.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="auth-alert auth-alert--error" role="alert">@Model.ErrorMessage</p>
            }

            <form class="signup-form" method="post" novalidate>
                <div class="form-group">
                    <label asp-for="FullName">Họ và tên</label>
                    <input asp-for="FullName" type="text" placeholder="Nguyễn Văn A" autocomplete="name" />
                </div>
                <div class="form-group">
                    <label asp-for="Email">Địa chỉ Email</label>
                    <input asp-for="Email" type="email" placeholder="example@serene.vn" autocomplete="email" />
                </div>
                <div class="form-group">
                    <label asp-for="Password">Mật khẩu</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="new-password" />
                </div>

                <div class="terms-row">
                    <input asp-for="AcceptTerms" type="checkbox" id="terms" />
                    <label for="terms">
                        Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và <a href="#">Chính sách bảo mật</a>
                    </label>
                </div>

                <button class="button primary" type="submit">Đăng ký ngay</button>
            </form>

            <div class="divider"><span>hoặc đăng ký bằng</span></div>
            <div class="social-grid">
                <button class="social-button google" type="button">
                    <img alt="Google" src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" />
                    Google
                </button>
                <button class="social-button" type="button">
                    <i data-lucide="facebook"></i>
                    Facebook
                </button>
            </div>

            <p class="footer-text">
                Đã có tài khoản? <a asp-page="/Dangnhap">Đăng nhập</a>
            </p>
            <p class="footer-text footer-text--sub"><a asp-page="/Index">Về trang chủ</a></p>
        </section>
    </main>
</div>
