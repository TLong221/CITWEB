@page
@model DangnhapModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideNav"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Dangnhap.css" asp-append-version="true" />
}

<div class="auth-page">
    <main class="auth-shell">
        <section class="auth-hero" aria-hidden="true">
            <div class="hero-overlay"></div>
            <div class="hero-copy">
                <h1>Tìm lại sự bình yên trong tâm hồn.</h1>
                <p>Một không gian an toàn để bạn trút bỏ những muộn phiền và chăm sóc sức khỏe tinh thần mỗi ngày.</p>
            </div>
        </section>

        <section class="auth-panel">
            <div class="auth-header">
                <div class="brand-mark"><i data-lucide="leaf"></i></div>
                <h2>Serene</h2>
                <p>Chào mừng bạn trở lại với hành trình tĩnh lặng.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="auth-alert auth-alert--error" role="alert">@Model.ErrorMessage</p>
            }

            <form class="auth-form" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" placeholder="ten@vidu.com" autocomplete="email" />
                </div>

                <div class="form-group password-group">
                    <div class="label-row">
                        <label asp-for="Password">Mật khẩu</label>
                        <a href="#" class="link">Quên mật khẩu?</a>
                    </div>
                    <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                </div>

                <button class="button primary" type="submit">Đăng nhập</button>
            </form>


            <div class="divider"><span>Hoặc đăng nhập bằng</span></div>
            <div class="social-grid">
                <button class="social-button" type="button">
                    <img alt="Google" src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" />
                    Google
                </button>
                <button class="social-button" type="button">
                    <i data-lucide="apple"></i>
                    Apple
                </button>
            </div>

            <p class="footer-text">Chưa có tài khoản? <a class="link" asp-page="/Dangky">Tham gia ngay</a></p>
            <p class="footer-text footer-text--sub"><a class="link" asp-page="/Index">Về trang chủ</a></p>
        </section>
    </main>
</div>
