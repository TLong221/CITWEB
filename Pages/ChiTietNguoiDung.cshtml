@page
@model ChiTietNguoiDungModel

@{
    ViewData["Title"] = "Tài khoản";
}

<div class="page-content">
    <section class="page-header">
        <h1 class="page-title">Thông tin tài khoản</h1>
        <p class="page-desc">Cập nhật hồ sơ cá nhân và quản lý quyền truy cập của bạn.</p>
    </section>

    <section class="card account-card">
        @if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
        {
            <p class="auth-alert auth-alert--error">@Model.FeedbackMessage</p>
        }

        <form method="post" asp-page-handler="SaveProfile" class="account-form">
            <div class="account-row">
                <span class="account-label">Email đăng nhập</span>
                <strong>@Model.Email</strong>
            </div>

            <div class="account-row">
                <span class="account-label">Vai trò</span>
                <strong class="role-badge @(Model.IsAdmin ? "role-badge--admin" : "role-badge--user")">
                    @Model.Role
                </strong>
            </div>

            <div class="profile-edit-grid">
                <div>
                    <label class="account-label" asp-for="FullNameInput">Họ tên</label>
                    <input class="profile-input" asp-for="FullNameInput" />
                </div>
                <div>
                    <label class="account-label" asp-for="PhoneInput">Số điện thoại</label>
                    <input class="profile-input" asp-for="PhoneInput" />
                </div>
                <div>
                    <label class="account-label" asp-for="AgeInput">Tuổi</label>
                    <input class="profile-input" asp-for="AgeInput" type="number" min="0" max="120" />
                </div>
                <div class="profile-edit-grid__full">
                    <label class="account-label" asp-for="BioInput">Giới thiệu</label>
                    <textarea class="profile-input" asp-for="BioInput" rows="4"></textarea>
                </div>
            </div>

            <div class="account-actions">
                <button class="btn-primary" type="submit">Lưu hồ sơ</button>
                @if (Model.IsAdmin)
                {
                    <a class="btn-outline" asp-page="/Admin">Trang quản trị</a>
                }
                <a class="btn-outline" asp-page="/Dangxuat">Đăng xuất</a>
            </div>
        </form>
        <div class="account-actions">
            @if (Model.IsAdmin)
            {
                <a class="btn-admin" asp-page="/Admin">Truy cập quản trị nâng cao</a>
            }
        </div>
    </section>
</div>