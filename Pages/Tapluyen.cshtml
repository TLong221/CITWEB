@page
@model TapluyenModel
@{
    ViewData["Title"] = "Tập luyện";
}

<div class="page-content">
    <section class="page-header">
        <h1 class="page-title">Tập luyện & Hoạt động</h1>
        <p class="page-desc">Duy trì vận động đều đặn giúp cải thiện tâm trạng và năng lượng mỗi ngày.</p>
    </section>

    <section class="workout-grid">
        <article class="card">
            <h3>Tổng quan tuần</h3>
            <p class="big-number">8,432 bước</p>
            <p class="section-desc">Hoàn thành 45 phút hoạt động tích cực hôm nay.</p>
        </article>

        <article class="card">
            <h3>Kế hoạch hôm nay</h3>
            <ul class="simple-list">
                <li><strong>Yoga sáng</strong><span>15 phút • cơ bản</span></li>
                <li><strong>Chạy bộ</strong><span>30 phút • mục tiêu 4km</span></li>
                <li><strong>Giãn cơ tối</strong><span>10 phút • 21:30</span></li>
            </ul>
            <button class="btn-primary">Bắt đầu bài tập</button>
        </article>

        <article class="card">
            <h3>Bài tập gợi ý</h3>
            <div class="chip-row">
                <span class="chip">Yoga phục hồi</span>
                <span class="chip">Cardio nhẹ</span>
                <span class="chip">HIIT 15 phút</span>
            </div>
        </article>
    </section>
</div>